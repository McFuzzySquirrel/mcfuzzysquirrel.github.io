---
import BaseLayout from "../../layouts/BaseLayout.astro";
import BlogArchive from "../../components/BlogArchive.astro";
import PageHeader from "../../components/PageHeader.astro";
import { getPosts, pagePosts, totalPages } from "../../lib/posts";

const posts = await getPosts();
const tags = [...new Set(posts.flatMap((post) => post.tags))].sort((left, right) =>
  left.localeCompare(right)
);
const total = totalPages(posts);
---

<BaseLayout
  title="Blog"
  description="Notes on what I built, what broke, and what I’d try next."
>
  <div class="shell">
    <PageHeader
      kicker="Notes from the workshop"
      title="Blog"
      intro="Notes on what I built, what broke, and what I’d try next."
    />
    <BlogArchive posts={pagePosts(posts, 1)} tags={tags} currentPage={1} totalPages={total} />
  </div>
</BaseLayout>
