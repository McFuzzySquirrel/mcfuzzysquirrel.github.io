---
import { getPosts } from "../lib/posts";
import { SITE } from "../lib/site";

export async function getStaticPaths() {
  const posts = await getPosts({ includeDrafts: false });

  return posts.map((post) => ({
    params: {
      legacy: post.legacyUrl.replace(/^\//, "").replace(/\.html$/, "")
    },
    props: {
      target: post.url,
      title: post.data.title
    }
  }));
}

const { target, title } = Astro.props;
const siteUrl = Astro.site ?? new URL(SITE.url);
const targetUrl = new URL(target, siteUrl).toString();
---

<!doctype html>
<html lang="en">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>Moved: {title}</title>
    <meta name="robots" content="noindex" />
    <link rel="canonical" href={targetUrl} />
    <meta http-equiv="refresh" content={`0; url=${target}`} />
    <script is:inline define:vars={{ target }}>window.location.replace(target);</script>
  </head>
  <body>
    <p>This note has moved to <a href={target}>{title}</a>.</p>
  </body>
</html>
