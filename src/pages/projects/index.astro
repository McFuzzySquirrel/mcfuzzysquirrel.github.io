---
import BaseLayout from "../../layouts/BaseLayout.astro";
import PageHeader from "../../components/PageHeader.astro";
import ProjectCard from "../../components/ProjectCard.astro";
import { getProjects } from "../../lib/projects";

const projects = await getProjects();
---

<BaseLayout
  title="Projects"
  description="Projects I’ve built to solve a problem, test an idea, or learn something by making it."
>
  <div class="shell">
    <PageHeader
      kicker="On the workbench"
      title="Projects"
      intro="Projects I’ve built to solve a problem, test an idea, or learn something by making it."
    />
    <div class="project-grid project-grid-large">
      {projects.map((project) => <ProjectCard project={project} />)}
    </div>
  </div>
</BaseLayout>
