---
import type { PostView } from "../lib/posts";

interface Props {
  post: PostView;
  heading?: "h2" | "h3";
  compact?: boolean;
}

const { post, heading = "h3", compact = false } = Astro.props;
const Heading = heading;
---

<article class:list={["post-card", { "post-card-compact": compact }]}>
  <p class="post-card-kicker">
    <time datetime={post.isoDate}>{post.dateLabel}</time>
    <span aria-hidden="true">·</span>
    <span>{post.readingMinutes} min read</span>
    {post.data.draft && <span class="draft-badge">Draft</span>}
  </p>
  <Heading class="post-card-title"><a href={post.url}>{post.data.title}</a></Heading>
  <p class="post-card-excerpt">{post.excerpt}</p>
  {post.tags.length > 0 && (
    <ul class="tag-list" aria-label="Tags">
      {post.tags.map((tag) => <li class="tag-chip tag-chip-static">{tag}</li>)}
    </ul>
  )}
</article>
