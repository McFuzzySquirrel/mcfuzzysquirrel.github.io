<a href="#top" class="back-to-top" data-back-to-top aria-label="Back to top" title="Back to top">
  <svg viewBox="0 0 24 24" aria-hidden="true" focusable="false">
    <path d="M12 19V5M5.5 11.5 12 5l6.5 6.5" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" />
  </svg>
</a>

<script>
  const button = document.querySelector<HTMLAnchorElement>("[data-back-to-top]");

  function syncVisibility() {
    button?.classList.toggle("is-visible", window.scrollY > 520);
  }

  window.addEventListener("scroll", syncVisibility, { passive: true });
  syncVisibility();
</script>
