---
import type { ProjectView } from "../lib/projects";

interface Props {
  project: ProjectView;
  featured?: boolean;
}

const { project, featured = false } = Astro.props;
---

<article class:list={["project-card", { "project-card-featured": featured }]}>
  {featured && (
    <img
      class="featured-stamp"
      src="/assets/images/featured-acorn-badge.png"
      alt=""
      width="320"
      height="320"
      aria-hidden="true"
      loading="lazy"
      decoding="async"
    />
  )}
  <div class="project-card-top">
    <span class="bench-number" aria-hidden="true">{String(project.order).padStart(2, "0")}</span>
    <div class="project-card-badges">
      {project.logo && (
        <img class="project-logo" src={project.logo} alt={`${project.title} logo`} width="64" height="64" loading="lazy" />
      )}
      {project.collaboration && <span class="project-credit">{project.collaboration}</span>}
    </div>
  </div>
  <h3 class="project-card-title">
    <a href={project.repositoryUrl} target="_blank" rel="noreferrer">{project.title}</a>
  </h3>
  <p class="project-card-description">{project.description}</p>
  {project.role && <p class="project-role">{project.role}</p>}
  <ul class="project-links">
    <li><a href={project.repositoryUrl} target="_blank" rel="noreferrer">Repository <span aria-hidden="true">↗</span></a></li>
    {project.demoUrl && <li><a href={project.demoUrl} target="_blank" rel="noreferrer">Try the demo <span aria-hidden="true">↗</span></a></li>}
    {project.storyUrl && <li><a href={project.storyUrl}>Build story</a></li>}
  </ul>
</article>
