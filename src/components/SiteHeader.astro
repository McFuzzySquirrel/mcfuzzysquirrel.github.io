---
import { NAV_LINKS, SITE } from "../lib/site";

const path = Astro.url.pathname.replace(/\/+$/, "") || "/";

function activeClass(href: string) {
  const target = href.replace(/\/+$/, "") || "/";
  const isActive = path === target || (target !== "/" && path.startsWith(`${target}/`));
  return isActive ? "is-active" : "";
}
---

<header class="site-header">
  <div class="shell header-inner">
    <a class="brand" href="/" aria-label={`${SITE.title} home`}>
      <span class="brand-mark" aria-hidden="true">
        <svg viewBox="0 0 32 32" focusable="false">
          <path d="M8.2 13.4C8.2 8.7 11.7 5 16 5s7.8 3.7 7.8 8.4" fill="none" stroke="currentColor" stroke-width="2.6" stroke-linecap="round" />
          <path d="M6.8 13.6h18.4c0 8.2-3.4 13.7-9.2 16.2-5.8-2.5-9.2-8-9.2-16.2Z" fill="currentColor" opacity=".16" />
          <path d="M6.8 13.6h18.4c0 8.2-3.4 13.7-9.2 16.2-5.8-2.5-9.2-8-9.2-16.2Z" fill="none" stroke="currentColor" stroke-width="2.2" stroke-linejoin="round" />
          <path d="M10.4 13.6c1.4 1 3.2 1.5 5.6 1.5s4.2-.5 5.6-1.5" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" />
        </svg>
      </span>
      <span class="brand-text">
        <strong>McFuzzySquirrel</strong>
        <small>Playground</small>
      </span>
    </a>

    <div class="header-actions">
      <nav class="site-nav desktop-nav" aria-label="Primary">
        {NAV_LINKS.map((link) => (
          <a class:list={["nav-link", activeClass(link.href)]} href={link.href} aria-current={activeClass(link.href) ? "page" : undefined}>
            {link.label}
          </a>
        ))}
      </nav>

      <details class="mobile-nav">
        <summary aria-label="Open navigation menu">
          <svg viewBox="0 0 24 24" aria-hidden="true" focusable="false">
            <path d="M4 7h16M4 12h16M4 17h16" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" />
          </svg>
          <span>Menu</span>
        </summary>
        <nav aria-label="Mobile primary">
          {NAV_LINKS.map((link) => (
            <a class:list={["nav-link", activeClass(link.href)]} href={link.href} aria-current={activeClass(link.href) ? "page" : undefined}>
              {link.label}
            </a>
          ))}
        </nav>
      </details>

      <button class="theme-toggle" type="button" data-theme-toggle aria-label="Toggle dark theme" aria-pressed="false">
        <svg class="theme-icon theme-icon-sun" viewBox="0 0 24 24" aria-hidden="true" focusable="false">
          <circle cx="12" cy="12" r="4.2" fill="currentColor" />
          <path d="M12 2.5v2.2M12 19.3v2.2M2.5 12h2.2M19.3 12h2.2M5.3 5.3l1.6 1.6M17.1 17.1l1.6 1.6M18.7 5.3l-1.6 1.6M6.9 17.1l-1.6 1.6" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" />
        </svg>
        <svg class="theme-icon theme-icon-moon" viewBox="0 0 24 24" aria-hidden="true" focusable="false">
          <path d="M20 14.4A8.4 8.4 0 0 1 9.6 4a8.5 8.5 0 1 0 10.4 10.4Z" fill="currentColor" />
        </svg>
      </button>
    </div>
  </div>
</header>

<script>
  const root = document.documentElement;
  const toggle = document.querySelector<HTMLButtonElement>("[data-theme-toggle]");
  const media = window.matchMedia("(prefers-color-scheme: dark)");

  function currentTheme() {
    return root.dataset.theme === "dark" ? "dark" : "light";
  }

  function syncToggle() {
    if (!toggle) return;
    const isDark = currentTheme() === "dark";
    toggle.setAttribute("aria-pressed", String(isDark));
    toggle.setAttribute("aria-label", isDark ? "Switch to light theme" : "Switch to dark theme");
    toggle.title = isDark ? "Switch to light theme" : "Switch to dark theme";
  }

  toggle?.addEventListener("click", () => {
    const next = currentTheme() === "dark" ? "light" : "dark";
    root.dataset.theme = next;
    root.style.colorScheme = next;
    try {
      localStorage.setItem("theme", next);
    } catch {
      /* Storage can be unavailable in private modes; the theme still applies for this page. */
    }
    syncToggle();
  });

  media.addEventListener?.("change", (event) => {
    try {
      if (localStorage.getItem("theme")) return;
    } catch {
      /* Fall through and follow the system preference. */
    }
    root.dataset.theme = event.matches ? "dark" : "light";
    root.style.colorScheme = root.dataset.theme;
    syncToggle();
  });

  syncToggle();
</script>
